  "item": [
    {
      "name": "Admin app authentication",
      "description": "Main admin app token; separate from sales api_token. Use an administrator account with CRM_LEAD VIEW/UPDATE/APPROVE and QUOTATION VIEW/APPROVE permissions. Set plant_id to an accessible plant. Share the same Postman environment between collections so lead_id and quotation_id captured by sales requests are available here. Run requests individually; approval/rejection are alternatives.",
      "item": [
        {
          "name": "Admin login (main app)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{base_url}}/api/mobile/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "mobile",
                "login"
              ]
            },
            "description": "Main admin app token; separate from sales api_token. Use an administrator account with CRM_LEAD VIEW/UPDATE/APPROVE and QUOTATION VIEW/APPROVE permissions. Set plant_id to an accessible plant. Share the same Postman environment between collections so lead_id and quotation_id captured by sales requests are available here. Run requests individually; approval/rejection are alternatives.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Successful response', () => pm.expect(pm.response.code).to.be.within(200,299));",
                  "const j=pm.response.json();",
                  "if (!j.token) { pm.environment.unset('admin_token'); pm.collectionVariables.unset('admin_token'); }",
                  "pm.test('Main app bearer token returned', () => pm.expect(j.token).to.be.a('string').and.not.empty);",
                  "if (j.token !== undefined && j.token !== null) { pm.collectionVariables.set('admin_token', j.token); pm.environment.set('admin_token', j.token); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Admin send email OTP (alternative)",
          "request": {
